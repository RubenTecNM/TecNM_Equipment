{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "LocalPath": "storage/documents",
    "MaxFileSizeBytes": 5242880
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Maintenance": {
    "ScheduleWindowDays": 30
  },
  "Security": {
    "RateLimiting": {
      "LoginPermitLimit": 10,
      "LoginWindowSeconds": 60,
      "RefreshPermitLimit": 30,
      "RefreshWindowSeconds": 60,
      "AccountMaxFailures": 5,
      "AccountFailureWindowMinutes": 15,
      "AccountLockoutMinutes": 15
    },
    "SessionValidation": {
      "CacheSeconds": 30
    }
  },
  "Jwt": {
    "ExpirationMinutes": 15
  },
  "Auth": {
    "SpaBaseUrl": "",
    "RefreshTokenDays": 7,
    "RefreshReuseGraceSeconds": 5,
    "CookieSecure": true,
    "AllowedEmailDomains": [],
    "Entra": {
      "TenantId": "",
      "ClientId": ""
    },
    "Google": {
      "ClientId": "",
      "HostedDomain": ""
    }
  }
}
