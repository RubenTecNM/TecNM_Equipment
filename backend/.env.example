# ============================================
# TecNM Assets Management — Backend
# ============================================
# Copiar como referencia. En desarrollo, los secretos JWT viven en user-secrets:
#   dotnet user-secrets set "Jwt:Secret" "<clave-larga-y-secreta>"
#   dotnet user-secrets set "Jwt:Issuer" "tecnm-inventario"
#   dotnet user-secrets set "Jwt:Audience" "tecnm-inventario-api"
#
# En contenedores/CI pueden usarse variables de entorno (formato __ o :).

# JWT
Jwt__Secret=
Jwt__Issuer=
Jwt__Audience=

# Login federado (fuera de Development son obligatorios si el proveedor tiene ClientId).
# TenantId nunca puede ser common, organizations ni consumers.
Auth__Entra__TenantId=
Auth__AllowedEmailDomains__0=
Auth__Google__HostedDomain=

# Nombres del servidor separados por ';'. Fuera de Development no puede ser '*' ni vacío.
AllowedHosts=

# Proxy inverso de confianza (IP o red CIDR). Vacío = solo loopback.
ForwardedHeaders__KnownProxies__0=
ForwardedHeaders__KnownNetworks__0=

# Límites de intentos (valores por defecto)
Security__RateLimiting__LoginPermitLimit=10
Security__RateLimiting__LoginWindowSeconds=60
Security__RateLimiting__RefreshPermitLimit=30
Security__RateLimiting__RefreshWindowSeconds=60
Security__RateLimiting__AccountMaxFailures=5
Security__RateLimiting__AccountFailureWindowMinutes=15
Security__RateLimiting__AccountLockoutMinutes=15

# Sesión: gracia de reúso del refresh (s) y caché del estado del usuario por petición (s; 0 = sin caché)
Auth__RefreshReuseGraceSeconds=5
Security__SessionValidation__CacheSeconds=30

# Base de datos (PostgreSQL en Docker, ver database/docker-compose.yml)
ConnectionStrings__Default=Host=localhost;Port=5433;Database=tecnm_inventario;Username=tecnm_dev;Password=

# Almacenamiento local de documentos
Storage__MaxFileSizeBytes=5242880
Storage__LocalPath=storage/documents

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
