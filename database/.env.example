# PostgreSQL de desarrollo — plantilla de variables.
# Copiar a database/.env y completar los valores. database/.env NO se versiona.
#
# Genera la contraseña con:
#   openssl rand -base64 24

POSTGRES_USER=tecnm_dev

# Obligatoria: docker compose no arranca si falta o está vacía.
POSTGRES_PASSWORD=

POSTGRES_DB=tecnm_inventario
